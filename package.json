{
  "name": "zombie-blaster",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:solo": "playwright test --grep @solo",
    "e2e:online": "playwright test --grep @online",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:chaos": "playwright test --grep @chaos",
    "e2e:net": "playwright test --grep @net",
    "e2e:protocol": "playwright test --grep @protocol",
    "e2e:bugs": "playwright test --grep @bug",
    "e2e:headed": "playwright test --headed --workers=1",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "e2e:demo": "playwright test --config e2e/demo/playwright.demo.config.ts",
    "e2e:lab": "playwright test --config e2e/lab/playwright.lab.config.ts",
    "icons": "node tools/pixel-icons/build.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.20.4",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
